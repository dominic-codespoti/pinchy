                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "stateManagement": {
    "serverState": {
      "tool": "TanStack Query (React Query)",
      "patterns": [
        "Prefetch on server components",
        "Stale-while-revalidate for lists",
        "Optimistic updates for mutations",
        "Query invalidation on mutations"
      ]
    },
    "clientState": {
      "tool": "Zustand",
      "store": "agent-store.ts",
      "scope": "UI-only state",
      "patterns": [
        "Tab selection synced to URL",
        "Search/filter state for list",
        "View mode preference",
        "Unsaved changes tracking"
      ]
    },
    "urlState": {
      "purpose": "Deep-linking support",
      "implementation": "next/navigation useSearchParams",
      "sync": "Two-way sync between URL and Zustand store",
      "params": {
        "tab": "Active tab on detail page",
        "file": "Selected file in files tab",
        "q": "Search query on list",
        "filter": "Active filters"
      }
    }
  },
  "dataFlow": {
    "listPage": [
      "Server: AgentsPage calls prefetchQuery for agents list",
      "Hydration: QueryClient dehydrates state to client",
      "Client: AgentsList renders with cached data",
      "Client: User interactions trigger mutations",
      "Client: On mutation success, invalidate agents query"
    ],
    "detailPage": [
      "Server: AgentDetailPage extracts ID from params",
      "Server: Prefetches agent data, sessions, memory",
      "Client: AgentDetail renders with cached data",
      "Client: Tab switching is instant (client-side)",
      "Client: Tab content fetches own data if needed",
      "Client: File edits tracked locally, saved on demand"
    ],
    "mutations": [
      "Optimistic update: Show change immediately",
      "Background request: Send to API",
      "Success: Confirm, invalidate related queries",
      "Error: Rollback optimistic update, show toast"
    ]
  },
  "uiSpecifications": {
    "layout": {
      "maxWidth": "max-w-7xl container",
      "padding": "px-4 py-6 sm:px-6 lg:px-8",
      "spacing": "gap-6 between sections"
    },
    "typography": {
      "pageTitle": "text-3xl font-bold tracking-tight",
      "sectionTitle": "text-xl font-semibold",
      "cardTitle": "text-lg font-medium",
      "body": "text-sm text-muted-foreground"
    },
    "colors": {
      "status": {
        "active": "bg-green-500",
        "inactive": "bg-gray-400",
        "error": "bg-red-500"
      },
      "priority": {
        "high": "text-red-600",
        "medium": "text-yellow-600",
        "low": "text-blue-600"
      }
    },
    "responsive": {
      "mobile": {
        "list": "1 column grid",
        "detail": "Stacked layout, collapsible hero"
      },
      "tablet": {
        "list": "2 column grid",
        "detail": "Side-by-side where applicable"
      },
      "desktop": {
        "list": "3-4 column grid",
        "detail": "Full tab interface with sidebar"
      }
    }
  },
  "accessibility": {
    "requirements": [
      "All interactive elements have aria-labels",
      "Tab navigation is keyboard accessible",
      "Focus management on modal open/close",
      "Loading states announced to screen readers",
      "Error messages associated with inputs"
    ],
    "keyboardShortcuts": [
      { "key": "/", "action": "Focus search" },
      { "key": "n", "action": "New agent" },
      { "key": "e", "action": "Edit current agent" },
      { "key": "t", "action": "Test current agent" },
      { "key": "1-6", "action": "Switch to tab N" }
    ]
  },
  "errorHandling": {
    "strategies": [
      {
        "level": "Route",
        "component": "error.tsx",
        "handles": ["Fetch errors", "Agent not found", "Server errors"]
      },
      {
        "level": "Component",
        "component": "ErrorBoundary",
        "handles": ["React errors", "Component crashes"]
      },
      {
        "level": "Query",
        "tool": "TanStack Query",
        "handles": ["API errors", "Retry logic", "Error states"]
      }
    ],
    "userFeedback": {
      "toast": "Success/error notifications via sonner",
      "inline": "Field-level validation errors",
      "fallback": "Error boundary UI with retry"
    }
  },
  "shadcnComponents": {
    "core": [
      "Card, CardHeader, CardTitle, CardContent, CardFooter",
      "Button (variants: default, outline, ghost, destructive)",
      "Badge (variants: default, secondary, outline, destructive)",
      "Tabs, TabsList, TabsTrigger, TabsContent",
      "Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter",
      "Sheet, SheetContent, SheetHeader, SheetTitle, SheetDescription, SheetFooter",
      "Input, Textarea",
      "Select, SelectContent, SelectItem, SelectTrigger, SelectValue",
      "DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger",
      "Skeleton",
      "ScrollArea",
      "Separator",
      "Tooltip",
      "Avatar, AvatarFallback",
      "Switch",
      "Checkbox"
    ],
    "customWrappers": [
      "StatusPill - Agent status display",
      "HeartbeatBadge - Last heartbeat time",
      "FormLabel - Consistent form labeling"
    ]
  },
  "dependencies": {
    "required": [
      "@tanstack/react-query - Server state management",
      "zustand - Client state management",
      "lucide-react - Icons",
      "@radix-ui/* - shadcn primitives",
      "@monaco-editor/react - File editor (optional)",
      "sonner - Toast notifications"
    ],
    "optional": [
      "date-fns - Date formatting",
      "zod - Form validation",
      "react-hook-form - Form management"
    ]
  },
  "implementationNotes": {
    "phase1": "Set up file structure, types, and API layer",
    "phase2": "Build list page with agents grid",
    "phase3": "Build detail shell with tab navigation",
    "phase4": "Implement each tab (overview, files, memory, sessions, test, settings)",
    "phase5": "Add dialogs (create, delete, clone)",
    "phase6": "Polish, accessibility, testing",
    "criticalPaths": [
      "File editor needs unsaved changes warning",
      "Test tab reuses existing WebSocket infrastructure",
      "Memory search supports keyword/semantic/hybrid modes",
      "All mutations have proper error handling"
    ]
  }
}
